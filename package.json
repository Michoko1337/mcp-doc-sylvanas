{
  "name": "mcp-sylvanas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing the official Project Sylvanas developer documentation (docs.project-sylvanas.net): full-text search, section reading, API symbol table and availability notes.",
  "main": "dist/index.js",
  "bin": {
    "mcp-sylvanas": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "selftest": "node dist/index.js --selftest",
    "test": "node tools/protocol-test.mjs",
    "fetch-docs": "node tools/fetch-docs.mjs",
    "inspect": "node tools/inspect-symbols.mjs",
    "preview": "node tools/preview.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Thomas C",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minchaka27/mcp-sylvanas.git"
  },
  "homepage": "https://github.com/minchaka27/mcp-sylvanas#readme",
  "bugs": {
    "url": "https://github.com/minchaka27/mcp-sylvanas/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "project-sylvanas",
    "wow",
    "documentation",
    "lua",
    "typescript"
  ],
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
